<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ActionsToolkit.Core" Version="1.0.0" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.6.1" />
    <!-- Preview-only package, used by the CloudflareTunnels tests. eng/update-aspire.sh does not
         move preview pins and Dependabot ignores Aspire.*: bump it by hand with each Aspire update. -->
    <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="13.6.1-preview.1.26506.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" />
    <PackageVersion Include="CliWrap" Version="3.10.4" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.303" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Shirubasoft.Spire.Sample.ModuleContract"
                    Version="$(SpireContractPackageVersion)"
                    Condition="'$(SpireContractPackageVersion)' != ''" />
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>
