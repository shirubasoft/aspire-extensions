<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Shirubasoft Aspire Tailscale integration</Title>
    <Authors>Shirubasoft</Authors>
    <Description>Expose Aspire resources privately on a Tailscale tailnet through sidecar containers with HTTPS.</Description>
    <AssemblyName>Shirubasoft.Aspire.Tailscale</AssemblyName>
    <RootNamespace>Aspire.Hosting</RootNamespace>
    <PackageId>Shirubasoft.Aspire.Tailscale</PackageId>
    <PackageTags>aspire;apphost;tailscale;tailnet;sidecar</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Shirubasoft/aspire-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shirubasoft/aspire-extensions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shirubasoft.Aspire.Extensions.Tailscale.Tests" />
  </ItemGroup>
</Project>
