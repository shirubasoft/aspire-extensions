<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Shirubasoft Aspire test diagnostics</Title>
    <Authors>Shirubasoft</Authors>
    <Description>Runner-independent console log and telemetry exports for Aspire distributed tests.</Description>
    <AssemblyName>Shirubasoft.Aspire.Extensions.TestDiagnostics</AssemblyName>
    <RootNamespace>Aspire.Hosting</RootNamespace>
    <PackageId>Shirubasoft.Aspire.Extensions.TestDiagnostics</PackageId>
    <PackageTags>aspire;testing;logs;traces;dashboard</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Shirubasoft/aspire-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Shirubasoft/aspire-extensions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shirubasoft.Aspire.Extensions.TestDiagnostics.Tests" />
  </ItemGroup>
</Project>
